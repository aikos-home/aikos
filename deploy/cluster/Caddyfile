{
	admin localhost:2019
	skip_install_trust
	# The house reverse proxy connects by address and may send no SNI; answer with the domain's certificate anyway.
	default_sni {$AIKOS_DOMAIN}
	servers {
		# Only the reverse proxy in front of the house may name the client (X-Real-IP below takes it from here).
		trusted_proxies static {$TRUSTED_PROXIES}
		trusted_proxies_strict
	}
}

# The app for people. The house reverse proxy holds the public certificate and forwards to the virtual address over
# HTTPS; Caddy uses its own CA here (the proxy does not verify it). Passkeys see only the public certificate.
{$AIKOS_DOMAIN} {
	tls internal
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
	reverse_proxy 127.0.0.1:8780 {
		header_up X-Real-IP {client_ip}
	}
}

# The house reverse proxy may also forward plain HTTP (its usual setting: http → <virtual address>:80). Requests from
# it are served here; anyone else asking over plain HTTP is sent to HTTPS (no redirect loop for the proxy).
http://{$AIKOS_DOMAIN} {
	@house_proxy remote_ip {$TRUSTED_PROXIES}
	handle @house_proxy {
		encode zstd gzip
		header -Server
		reverse_proxy 127.0.0.1:8780 {
			header_up X-Real-IP {client_ip}
		}
	}
	handle {
		redir https://{host}{uri} 308
	}
}

# This node's health for the rollout agents of the peers: one path, plain HTTP, addressed by the node's own address
# (port 80 is open in the house network; the domain's HTTPS redirect on :80 answers only for the domain name).
http://{$NODE_IP} {
	handle /api/v1/health {
		reverse_proxy 127.0.0.1:8780
	}
	handle {
		respond 404
	}
}
