# aikos transcriber: the settings of your house, shared by both sides (room and door).
# Copy to ~/.aikos/transcriber.env, chmod 600, fill in. Never commit the filled-in file.
# The token file holds a long-lived Home Assistant token of a user made only for the transcriber.

# required
AIKOS_HA_URL=http://homeassistant.local:8123
AIKOS_HA_TOKEN_FILE=/Users/you/.aikos/ha-transcriber.token

# optional
# household first names, comma-separated: Whisper spells them right and "who speaks" knows them
AIKOS_KNOWN_NAMES=Anna,Jonas
# test senders: their text goes to the *_test entities only. 127.0.0.1 is needed by deploy/smoke.py.
AIKOS_TEST_SOURCES=127.0.0.1
# AIKOS_WHISPER_URL=http://127.0.0.1:6667/v1/audio/transcriptions
# AIKOS_LLM_URL=http://127.0.0.1:11434
# door side: 1 = cut the door audio into utterances at pauses (door mic on for the whole call, voice v2)
# AIKOS_SPLIT=1
# Room side, R28: translate the resident's answer into the visitor's language (needs aikos integration >= 0.6.0). Default 0.
# AIKOS_VISITOR_TRANSLATION=1
