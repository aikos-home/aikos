{
  "openapi": "3.1.0",
  "info": {
    "title": "aikos app API",
    "version": "1",
    "description": "The only way from a phone to Home Assistant in an aikos house. Sign-in with passkeys only. Session as HttpOnly cookie (PWA) or, with header `X-Aikos-Client: native`, as bearer token (native apps). Errors: `{\"error\": \"<code>\"}`. Writes from a browser must carry the app's own Origin."
  },
  "components": {
    "securitySchemes": {
      "cookie": {"type": "apiKey", "in": "cookie", "name": "aikos_session"},
      "bearer": {"type": "http", "scheme": "bearer"}
    },
    "schemas": {
      "Error": {"type": "object", "properties": {"error": {"type": "string"}}, "required": ["error"]},
      "User": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"}, "name": {"type": "string"},
          "role": {"enum": ["superadmin", "adult", "child"]},
          "ha_person": {"type": "string", "description": "Home Assistant person entity, may be empty"},
          "capabilities": {"type": "array", "items": {"type": "string"}}
        }
      },
      "Ceremony": {
        "type": "object",
        "properties": {"flow": {"type": "string"}, "options": {"type": "object", "description": "WebAuthn options (JSON form)"}}
      },
      "CeremonyFinish": {
        "type": "object",
        "properties": {"flow": {"type": "string"}, "credential": {"type": "object", "description": "WebAuthn credential (JSON form)"}},
        "required": ["flow", "credential"]
      },
      "SignedIn": {
        "type": "object",
        "properties": {"user": {"$ref": "#/components/schemas/User"}, "token": {"type": "string", "description": "only for native clients"}}
      },
      "DoorMessage": {
        "type": "object",
        "properties": {
          "id": {"type": "string"}, "content_type": {"type": "string"},
          "time": {"type": "string", "description": "ISO time"},
          "seconds": {"type": ["number", "null"]}, "text": {"type": "string"},
          "recipient": {"type": "string", "description": "\"\" = for everyone"},
          "speaker": {"type": "string"}, "heard_by": {"type": "array", "items": {"type": "string"}},
          "heard": {"type": "boolean", "description": "I have heard it"},
          "may_delete": {"type": "boolean", "description": "A38: recipient or superadmin; for everyone: adults too"},
          "audio_missing": {"type": "boolean"},
          "audio": {"type": ["string", "null"], "description": "path of the audio stream in this API; null if the file is gone"}
        }
      },
      "DoorStatus": {
        "type": "object",
        "properties": {
          "someone_at_door": {"type": ["boolean", "null"]}, "someone_since": {"type": ["number", "null"]},
          "quiet_hours": {"type": ["boolean", "null"]}, "quiet_start": {"type": "string"}, "quiet_end": {"type": "string"},
          "bell_muted": {"type": ["boolean", "null"]}, "bell_muted_until": {"type": "string", "description": "\"\" while muted = until switched off"},
          "quiet_enabled": {"type": ["boolean", "null"]}, "ha_connected": {"type": "boolean"}
        }
      },
      "Passkey": {
        "type": "object",
        "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "created_at": {"type": "integer"}, "last_used_at": {"type": ["integer", "null"]}}
      },
      "Link": {"type": "object", "properties": {"link": {"type": "string"}, "expires_at": {"type": "integer"}}}
    }
  },
  "paths": {
    "/api/v1/health": {"get": {"summary": "Service and Home Assistant reachability", "responses": {"200": {"description": "ok"}}}},
    "/api/v1/openapi.json": {"get": {"summary": "This document", "responses": {"200": {"description": "ok"}}}},
    "/.well-known/assetlinks.json": {"get": {"summary": "Digital asset links for a later Android app", "responses": {"200": {"description": "ok"}}}},
    "/api/v1/setup": {"get": {"summary": "Whether the first person still has to be set up", "responses": {"200": {"description": "{needs_setup}"}}}},
    "/api/v1/setup/start": {"post": {"summary": "Setup code + name → passkey registration options", "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ceremony"}}}, "description": "ok"}, "400": {"description": "invalid_code, invalid_name"}, "409": {"description": "already_set_up"}}}},
    "/api/v1/setup/finish": {"post": {"summary": "First person (superadmin) with the new passkey; signs in", "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/SignedIn"}}}, "description": "ok"}}}},
    "/api/v1/invites/info": {"post": {"summary": "Who an invite is for ({token})", "responses": {"200": {"description": "{name, role, kind, expires_at}"}, "400": {"description": "invite_invalid"}}}},
    "/api/v1/invites/start": {"post": {"summary": "Invite token → passkey registration options", "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ceremony"}}}, "description": "ok"}}}},
    "/api/v1/invites/finish": {"post": {"summary": "New person or new device; signs in. Each invite works once, 24 h", "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/SignedIn"}}}, "description": "ok"}}}},
    "/api/v1/login/start": {"post": {"summary": "Passkey login options (no user name)", "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ceremony"}}}, "description": "ok"}}}},
    "/api/v1/login/finish": {"post": {"summary": "Verify the passkey; signs in", "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/SignedIn"}}}, "description": "ok"}, "400": {"description": "unknown_passkey, passkey_failed, flow_expired"}}}},
    "/api/v1/logout": {"post": {"summary": "End this session", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"description": "ok"}}}},
    "/api/v1/logout/all": {"post": {"summary": "End all sessions of this person", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"description": "ok"}}}},
    "/api/v1/me": {"get": {"summary": "The signed-in person", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/User"}}}, "description": "ok"}, "401": {"description": "not_signed_in"}}}},
    "/api/v1/me/voice": {"get": {"summary": "My own voice (A43-A45): {available, voice: {seconds, created} | null, reading}", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"description": "state"}}}, "put": {"summary": "Record my own voice: audio body (8-60 s, at most 900 KB), goes to the house's voice service only", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"description": "{seconds, created}"}, "400": {"description": "voice_recording / bad_type / too_large"}, "503": {"description": "no_voice_service / voice_service_unreachable"}}}, "delete": {"summary": "Delete my own voice for good", "security": [{"cookie": []}, {"bearer": []}], "responses": {"204": {"description": "deleted"}}}},
    "/api/v1/me/voice/sample": {"post": {"summary": "A test sentence in my own voice (WAV)", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"description": "audio/wav"}, "404": {"description": "no_voice"}}}},
    "/api/v1/me/passkeys": {"get": {"summary": "My passkeys", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Passkey"}}}}, "description": "ok"}}}},
    "/api/v1/me/passkeys/start": {"post": {"summary": "Add a passkey: options", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ceremony"}}}, "description": "ok"}}}},
    "/api/v1/me/passkeys/finish": {"post": {"summary": "Add a passkey: verify", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"description": "ok"}}}},
    "/api/v1/me/passkeys/{cred_id}": {"delete": {"summary": "Remove one of my passkeys (never the last)", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"description": "ok"}, "409": {"description": "last_passkey_or_unknown"}}}},
    "/api/v1/people": {"get": {"summary": "All people (superadmin)", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"description": "ok"}, "403": {"description": "forbidden"}}}},
    "/api/v1/people/invites": {"post": {"summary": "Invite a person {name, role, ha_person} (superadmin)", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Link"}}}, "description": "ok"}}}},
    "/api/v1/people/{user_id}/device-invite": {"post": {"summary": "Link that adds a passkey to this person (superadmin)", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Link"}}}, "description": "ok"}}}},
    "/api/v1/people/{user_id}/disable": {"post": {"summary": "Block a person and end their sessions (superadmin)", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"description": "ok"}}}},
    "/api/v1/door/status": {"get": {"summary": "Someone at the door, quiet hours, bell muted", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/DoorStatus"}}}, "description": "ok"}}}},
    "/api/v1/door/messages": {"get": {"summary": "Door messages visible to me (A15: for me, for everyone; superadmin all)", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/DoorMessage"}}}}, "description": "ok"}, "503": {"description": "ha_unreachable"}}}},
    "/api/v1/push/key": {"get": {"summary": "The app's VAPID public key (applicationServerKey) for subscribing", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"description": "{key}"}}}},
    "/api/v1/push/subscription": {"post": {"summary": "Subscribe this device (endpoint of a known push service, keys p256dh + auth)", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"description": "ok"}, "400": {"description": "bad_subscription"}}}, "delete": {"summary": "Unsubscribe this device (body: endpoint)", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"description": "ok"}}}},
    "/api/v1/push/test": {"post": {"summary": "A test push to my own devices", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"description": "{sent}"}}}},
    "/api/v1/door/actions": {"get": {"summary": "Door actions now: waiting note, greeting, picture (null without aikos 0.9.0)", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"description": "state"}}}},
    "/api/v1/door/bell": {"post": {"summary": "Bell mute (A14/A40): {minutes} | {until_time: HH:MM} | {forever: true} | {off: true}; needs bell.settings", "security": [{"cookie": []}, {"bearer": []}], "responses": {"204": {"description": "done"}, "400": {"description": "bad_request / invalid"}, "403": {"description": "forbidden"}, "503": {"description": "no_door_actions / ha_unreachable"}}}},
    "/api/v1/door/quiet-hours": {"post": {"summary": "Quiet hours: {enabled, start: HH:MM, end: HH:MM}; needs bell.settings", "security": [{"cookie": []}, {"bearer": []}], "responses": {"204": {"description": "done"}, "400": {"description": "bad_request / invalid"}, "403": {"description": "forbidden"}, "503": {"description": "no_door_actions / ha_unreachable"}}}},
    "/api/v1/door/say": {"post": {"summary": "A note to the door (A11/A39): {message}; now if someone is there, else for the next visitor; needs door.act", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"description": "{delivered: now | waiting}"}, "400": {"description": "bad_request / invalid"}, "403": {"description": "forbidden"}, "503": {"description": "no_door_actions / ha_unreachable"}}}, "delete": {"summary": "Withdraw the waiting note", "security": [{"cookie": []}, {"bearer": []}], "responses": {"204": {"description": "done"}, "400": {"description": "bad_request / invalid"}, "403": {"description": "forbidden"}, "503": {"description": "no_door_actions / ha_unreachable"}}}},
    "/api/v1/door/picture": {"put": {"summary": "The door picture (A12/A41): JPEG/PNG/WebP body, at most 900 KB (the phone shrinks it first)", "security": [{"cookie": []}, {"bearer": []}], "responses": {"204": {"description": "done"}, "400": {"description": "bad_request / invalid"}, "403": {"description": "forbidden"}, "503": {"description": "no_door_actions / ha_unreachable"}}}, "delete": {"summary": "Remove the door picture", "security": [{"cookie": []}, {"bearer": []}], "responses": {"204": {"description": "done"}, "400": {"description": "bad_request / invalid"}, "403": {"description": "forbidden"}, "503": {"description": "no_door_actions / ha_unreachable"}}}, "get": {"summary": "The door picture as the door shows it (grey PNG)", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"description": "image/png"}, "404": {"description": "not_found"}}}},
    "/api/v1/door/greeting": {"put": {"summary": "The greeting (A13/A26): {enabled, text, start, end, always}", "security": [{"cookie": []}, {"bearer": []}], "responses": {"204": {"description": "done"}, "400": {"description": "bad_request / invalid"}, "403": {"description": "forbidden"}, "503": {"description": "no_door_actions / ha_unreachable"}}}},
    "/api/v1/door/greeting/audio": {"put": {"summary": "The greeting's recorded sound: audio body, at most 900 KB", "security": [{"cookie": []}, {"bearer": []}], "responses": {"204": {"description": "done"}, "400": {"description": "bad_request / invalid"}, "403": {"description": "forbidden"}, "503": {"description": "no_door_actions / ha_unreachable"}}}, "delete": {"summary": "Remove the greeting's sound", "security": [{"cookie": []}, {"bearer": []}], "responses": {"204": {"description": "done"}, "400": {"description": "bad_request / invalid"}, "403": {"description": "forbidden"}, "503": {"description": "no_door_actions / ha_unreachable"}}}, "get": {"summary": "The greeting's sound (to listen to it)", "security": [{"cookie": []}, {"bearer": []}], "responses": {"200": {"description": "audio"}, "404": {"description": "not_found"}}}},
    "/api/v1/door/messages/{message_id}": {"delete": {"summary": "Delete a door message for good, sound and text (A38)", "security": [{"cookie": []}, {"bearer": []}], "responses": {"204": {"description": "deleted"}, "403": {"description": "forbidden"}, "404": {"description": "not_found (also for someone else's message)"}, "503": {"description": "no_register / ha_unreachable"}}}},
    "/api/v1/door/messages/{message_id}/heard": {"post": {"summary": "I have heard this message (kept in Home Assistant)", "security": [{"cookie": []}, {"bearer": []}], "responses": {"204": {"description": "noted"}, "404": {"description": "not_found"}, "503": {"description": "no_register / ha_unreachable"}}}},
    "/api/v1/door/messages/{message_id}/audio": {"get": {"summary": "The message's sound, streamed through the app (Range supported). share=1: as a file to forward by hand (A37), recorded", "security": [{"cookie": []}, {"bearer": []}], "parameters": [{"name": "share", "in": "query", "required": false, "schema": {"type": "string", "enum": ["1"]}}], "responses": {"200": {"description": "audio"}, "206": {"description": "partial audio"}, "404": {"description": "not_found (also for someone else's message)"}}}}
  }
}
