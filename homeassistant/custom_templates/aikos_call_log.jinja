{#- aikos call log (aikos stack thread). The one place that decides how a transcript becomes a chat message.
    Used by packages/aikos.yaml for sensor.aikos_call_log (live) and sensor.aikos_call_log_test (test), see features/sprechen.md §4b.
    me = this (previous state of the log sensor), trigger = the trigger, call_entity = door call sensor ('' for the test log).
    Returns JSON: {messages (≤ 20), call_id, active, last_id, state}. -#}
{% macro aikos_call_log(me, trigger, call_entity) -%}
{%- set pa = me.attributes if (me is defined and me is not none and me.attributes is defined) else {} -%}
{%- set pm = pa.get('messages', []) -%}
{%- set prev = pm if (pm is iterable and pm is not string) else [] -%}
{%- set prev_call = pa.get('call_id', '') -%}
{%- set call_start = trigger.id == 'call' and trigger.to_state is not none and trigger.to_state.state == 'on'
      and (trigger.from_state is none or trigger.from_state.state != 'on') -%}
{%- set reset = call_start or trigger.id == 'testcall' -%}
{%- set ns = namespace(out=([] if reset else (prev | list))) -%}
{%- if trigger.id == 'msg' and trigger.to_state is not none and trigger.to_state.state not in ['unknown', 'unavailable', ''] -%}
  {%- set a = trigger.to_state.attributes -%}
  {%- set side = 'door' if '_door' in trigger.entity_id else 'room' -%}
  {%- set spk = a.get('speaker') or '' -%}
  {%- set who = spk if spk else ('Besucher' if side == 'door' else (a.get('device') or 'Bewohner')) -%}
  {%- set body = (a.get('message') or a.get('text') or '')[:300] -%}
  {%- set lang = (a.get('language_name') or '') if (a.get('language') and a.get('language') != 'de') else '' -%}
  {%- set entry = {'id': side ~ '-' ~ trigger.to_state.state, 't': trigger.to_state.state, 'side': side, 'who': who,
                   'role': a.get('speaker_role') or '', 'text': body, 'urgent': (a.get('urgent', false) | bool), 'lang': lang} -%}
  {%- set m2 = namespace(out=[], found=false) -%}
  {%- for m in ns.out -%}
    {%- if m.id == entry.id -%}{%- set m2.out = m2.out + [entry] -%}{%- set m2.found = true -%}
    {%- else -%}{%- set m2.out = m2.out + [m] -%}{%- endif -%}
  {%- endfor -%}
  {%- if not m2.found -%}{%- set m2.out = m2.out + [entry] -%}{%- endif -%}
  {%- set ns.out = m2.out[-20:] -%}
{%- endif -%}
{%- set msgs = ns.out -%}
{%- set call_id = (trigger.to_state.last_changed.isoformat(timespec='seconds') if call_start
                   else (trigger.to_state.state if trigger.id == 'testcall' else prev_call)) -%}
{{- {'messages': msgs, 'call_id': call_id,
     'active': (is_state(call_entity, 'on') if call_entity else false),
     'last_id': ((msgs | last).id if msgs else ''),
     'state': ((msgs | last).t if msgs else (me.state if (me is defined and me is not none) else 'unknown'))} | to_json -}}
{%- endmacro %}
